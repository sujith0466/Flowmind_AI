GEMINI_API_KEY=your_gemini_api_key_here
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-string
PORT=5000
FRONTEND_URL=https://your-flowmind-frontend.vercel.app
CORS_ORIGINS=https://your-flowmind-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
MAX_WORKFLOW_INPUT_CHARS=12000
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
